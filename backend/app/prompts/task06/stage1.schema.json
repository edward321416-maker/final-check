{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "rule", "modality", "severity", "verifier", "condition", "evidence", "confidence"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"},
          "rule": {"type": "string", "minLength": 1, "maxLength": 2000},
          "modality": {"type": "string", "enum": ["MUST", "MUST_NOT", "SHOULD", "MAY", "INFO"]},
          "severity": {"type": "string", "enum": ["BLOCKER", "REVIEW", "INFO", "EXTERNAL"]},
          "verifier": {"type": "string", "enum": ["DETERMINISTIC", "SEMANTIC", "VISION_SEMANTIC", "URL_CHECK", "EXTERNAL"]},
          "condition": {"type": "string", "minLength": 1, "maxLength": 1000},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_section", "quote"],
            "properties": {
              "source_section": {"type": "string", "minLength": 1, "maxLength": 300},
              "quote": {"type": "string", "minLength": 1, "maxLength": 4000}
            }
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
