{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "decision", "reason", "semantic_support", "condition_preserved", "modality_supported", "needs_more_context", "duplicate_of"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"},
          "decision": {"type": "string", "enum": ["KEEP", "REVIEW", "DROP"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
          "semantic_support": {"type": "boolean"},
          "condition_preserved": {"type": "boolean"},
          "modality_supported": {"type": "boolean"},
          "needs_more_context": {"type": "boolean"},
          "duplicate_of": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"}
        }
      }
    }
  }
}
