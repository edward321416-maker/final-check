{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reviews": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
          },
          "assessment": {
            "type": "string",
            "enum": [
              "RELATED_EVIDENCE_FOUND",
              "NO_CLEAR_EVIDENCE"
            ]
          },
          "evidence_candidates": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "document_id": {
                  "type": "string",
                  "const": "D01"
                },
                "page_id": {
                  "type": "string",
                  "pattern": "^D01-P[0-9]{3}$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "document_id",
                "page_id",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "requirement_id",
          "assessment",
          "evidence_candidates"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "reviews"
  ],
  "additionalProperties": false
}
